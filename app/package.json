{
  "name": "entrevista-twin",
  "productName": "Entrevista Twin",
  "version": "0.1.0",
  "private": true,
  "description": "Conduz a entrevista de identidade do twin e grava a transcrição bruta na máquina do cliente.",
  "main": "dist/electron/electron/main.js",
  "scripts": {
    "dev": "vite",
    "build:renderer": "vite build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build": "npm run build:renderer && npm run build:electron",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "empacotar:mac": "npm run build && electron-builder --mac",
    "empacotar:mac:dir": "npm run build && electron-builder --mac dir",
    "empacotar:linux": "npm run build && electron-builder --linux dir"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/spectral": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  },
  "author": {
    "name": "Antonio Carlos Monteiro da Silva Filho",
    "email": "tonico@monteirodasilva.com.br"
  },
  "homepage": "https://github.com/tonico-lgtm/Claude-",
  "repository": {
    "type": "git",
    "url": "https://github.com/tonico-lgtm/Claude-.git"
  }
}
